<Window x:Class="LLM2Everything.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="820" Width="820" MinHeight="700" MinWidth="760" Background="#F7F7F8"
        SizeToContent="Manual">
    <DockPanel Margin="14">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10"
                Visibility="{Binding StatusText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="自動検出" Command="{Binding AutoDetectCommand}" MinWidth="88"/>
                <TextBlock Text="{Binding StatusText}" Foreground="#1D4ED8" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F7F7F8" Padding="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="ログフォルダーを開く" Command="{Binding OpenLogFolderCommand}"/>
                <Button Content="保存" Command="{Binding SaveCommand}" MinWidth="88"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Everything" Background="White" Margin="0,0,0,10">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="es.exe パス" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Settings.EsExePath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="参照" Command="{Binding BrowseEsExeCommand}" MinWidth="70"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Everything.exe パス" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.EverythingPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="参照" Command="{Binding BrowseEverythingExeCommand}" MinWidth="70"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="検索タイムアウト秒" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.EverythingTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Row="3" Grid.Column="2" Content="確認" Command="{Binding TestEverythingCommand}" MinWidth="70"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Ollama" Background="White" Margin="0,0,0,10">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="URL" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Settings.OllamaUrl, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="モデル名" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.OllamaModel, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="モデル一覧取得" Command="{Binding LoadModelsCommand}" MinWidth="120"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="導入済みモデル" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Models}" SelectedItem="{Binding Settings.OllamaModel}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="タイムアウト秒" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.OllamaTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Row="4" Grid.Column="2" Content="接続確認" Command="{Binding TestOllamaCommand}" MinWidth="90"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="表示と保存" Background="White" Margin="0,0,0,10">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="検索結果上限" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ResultLimitOptions}" SelectedItem="{Binding Settings.ResultLimit}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="タイムゾーン" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.TimeZoneId, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Grid.Row="2" Grid.Column="1" Content="診断モード" IsChecked="{Binding Settings.DiagnosticMode}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="ファイルタイプ定義" Background="White" Margin="0,0,0,10">
                    <DataGrid ItemsSource="{Binding FileTypes}" AutoGenerateColumns="False" Height="210" CanUserAddRows="True" CanUserDeleteRows="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名前" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                            <DataGridTextColumn Header="拡張子" Binding="{Binding ExtensionsText, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
