<Window x:Class="LLM2Everything.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:LLM2Everything.Core;assembly=LLM2Everything.Core"
        Title="{x:Static core:ProductInfo.WindowTitle}" Height="760" Width="1120"
        MinHeight="640" MinWidth="960" Background="#F7F7F8">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
    </Window.InputBindings>
    <DockPanel Margin="14">
        <Border DockPanel.Dock="Top" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10"
                Visibility="{Binding WarningText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="設定を開く" Command="{Binding OpenSettingsCommand}" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding WarningText}" Foreground="#9A3412" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="検索したい内容" FontWeight="SemiBold" Margin="4,0,0,2"/>
            <TextBox Grid.Row="1" Grid.Column="0" FontSize="18" Height="40"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="例: 昨日のPDF / EドライブのGGUF / releaseを除くソースコード"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
            <Button Grid.Row="1" Grid.Column="1" Content="検索" Command="{Binding SearchCommand}" MinWidth="74"/>
            <Button Grid.Row="1" Grid.Column="2" Content="キャンセル" Command="{Binding CancelCommand}" MinWidth="86"/>
            <Button Grid.Row="1" Grid.Column="3" Content="設定" Command="{Binding OpenSettingsCommand}" MinWidth="70"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="例: 昨日のPDF、EドライブのGGUF、1GB以上のZIP、releaseを除くソースコード"
                       Foreground="#6B7280" Margin="4,0,0,0"/>
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="対象フォルダー" FontWeight="SemiBold" Margin="4,0,0,2"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="種別指定" FontWeight="SemiBold" Margin="4,0,0,2"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="ファイルタイプ" FontWeight="SemiBold" Margin="4,0,0,2"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="拡張子" FontWeight="SemiBold" Margin="4,0,0,2"/>
            <TextBox Grid.Row="1" Grid.Column="0" Height="30"
                     Text="{Binding FolderText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="省略時は全体検索。複数フォルダーは ; で区切ります"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Height="30"
                      ItemsSource="{Binding FileTypeModeOptions}" DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedFileTypeModeOption}"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
            <ComboBox Grid.Row="1" Grid.Column="2" Height="30"
                      ItemsSource="{Binding FileTypes}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedFileType}"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
            <TextBox Grid.Row="1" Grid.Column="3" Height="30"
                     Text="{Binding ExtensionText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="例: pdf, docx, gguf。先頭の . は不要です"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
        </Grid>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="変換詳細" Command="{Binding ToggleDetailCommand}"/>
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="4,0,12,0"/>
                <TextBlock Text="{Binding ElapsedText}" Foreground="#6B7280"/>
            </DockPanel>
        </Border>

        <Expander DockPanel.Dock="Top" Header="変換詳細" IsExpanded="{Binding IsDetailVisible}" Margin="0,0,0,10">
            <Grid Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,4,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="Everything検索式" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,8,0"/>
                    <Button DockPanel.Dock="Right" Content="この検索式で再検索" Command="{Binding SearchEditedQueryCommand}"/>
                    <TextBox Text="{Binding EditableEverythingQuery, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBox Grid.Row="1" Text="{Binding DetailText}" FontFamily="Consolas" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </Expander>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="検索履歴" Margin="0,0,10,0" Background="White">
                <ListBox ItemsSource="{Binding History}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.RerunHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" HorizontalContentAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="{Binding Input}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ResultCount, StringFormat={}{0}件}" FontSize="11" Foreground="#6B7280"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <ListView Grid.Column="1" ItemsSource="{Binding Results}" Background="White"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      MouseDoubleClick="Results_DoubleClick" GridViewColumnHeader.Click="GridViewColumnHeader_Click">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="開く" Command="{Binding PlacementTarget.DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="エクスプローラーで選択" Command="{Binding PlacementTarget.DataContext.OpenParentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="フルパスをコピー" Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ファイル名" DisplayMemberBinding="{Binding FileName}" Width="230"/>
                        <GridViewColumn Header="フルパス" DisplayMemberBinding="{Binding FullPath}" Width="470"/>
                        <GridViewColumn Header="拡張子" DisplayMemberBinding="{Binding Extension}" Width="80"/>
                        <GridViewColumn Header="サイズ" DisplayMemberBinding="{Binding SizeBytes}" Width="120"/>
                        <GridViewColumn Header="更新日時" DisplayMemberBinding="{Binding ModifiedAt}" Width="170"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DockPanel>
</Window>
