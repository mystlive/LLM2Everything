<Window x:Class="LLM2Everything.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:LLM2Everything.Core;assembly=LLM2Everything.Core"
        Title="{x:Static core:ProductInfo.WindowTitle}" Height="760" Width="1120">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
    </Window.InputBindings>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding WarningText}" Foreground="#B45309" Margin="4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" FontSize="18" Height="38" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                <Button Grid.Column="1" Content="検索" Command="{Binding SearchCommand}"/>
                <Button Grid.Column="2" Content="キャンセル" Command="{Binding CancelCommand}"/>
                <Button Grid.Column="3" Content="設定" Command="{Binding OpenSettingsCommand}"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding FolderText, UpdateSourceTrigger=PropertyChanged}" ToolTip="複数フォルダーは ; で区切ります" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                <ComboBox Grid.Column="1" Width="130" ItemsSource="{Binding FileTypeModes}" SelectedItem="{Binding SelectedFileTypeMode}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding FileTypes}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedFileType}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                <TextBox Grid.Column="3" Text="{Binding ExtensionText, UpdateSourceTrigger=PropertyChanged}" ToolTip="拡張子を空白、カンマ、セミコロンで区切ります" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
            </Grid>
            <DockPanel>
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="4"/>
                <TextBlock Text="{Binding ElapsedText}" Margin="12,4,4,4"/>
                <Button Content="詳細" Command="{Binding ToggleDetailCommand}" HorizontalAlignment="Right"/>
            </DockPanel>
            <Expander Header="変換結果" IsExpanded="{Binding IsDetailVisible}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="160"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBox Text="{Binding EditableEverythingQuery, UpdateSourceTrigger=PropertyChanged}" MinWidth="700"/>
                        <Button Content="この検索式で再検索" Command="{Binding SearchEditedQueryCommand}"/>
                    </DockPanel>
                    <TextBox Grid.Row="1" Text="{Binding DetailText}" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Expander>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="検索履歴" Margin="4">
                <ListBox ItemsSource="{Binding History}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.RerunHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="{Binding Input}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ResultCount, StringFormat={}{0}件}" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
            <ListView Grid.Column="1" ItemsSource="{Binding Results}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="Results_DoubleClick" GridViewColumnHeader.Click="GridViewColumnHeader_Click" Margin="4">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="開く" Command="{Binding PlacementTarget.DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="エクスプローラーで選択" Command="{Binding PlacementTarget.DataContext.OpenParentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="フルパスをコピー" Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ファイル名" DisplayMemberBinding="{Binding FileName}" Width="220"/>
                        <GridViewColumn Header="フルパス" DisplayMemberBinding="{Binding FullPath}" Width="520"/>
                        <GridViewColumn Header="拡張子" DisplayMemberBinding="{Binding Extension}" Width="90"/>
                        <GridViewColumn Header="サイズ" DisplayMemberBinding="{Binding SizeBytes}" Width="110"/>
                        <GridViewColumn Header="更新日時" DisplayMemberBinding="{Binding ModifiedAt}" Width="170"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DockPanel>
</Window>
